# ============================================================
#  backend/server/.gitignore
#  (Root .gitignore also applies — this adds server-specifics)
# ============================================================

# Node
node_modules/
npm-debug.log*

# Secrets — CRITICAL
.env
.env.*
!.env.example

# Runtime uploads (Multer temp files)
uploads/

# Python bridges / ML artifacts
__pycache__/
*.pyc
*.pyo
venv/
.venv/

# ML model caches
cache/
models/*.bin
models/*.safetensors
models/*.h5
models/*.pt
models/*.ckpt

# Server logs (generated at runtime)
logs/
*.log

# Prisma generated client
node_modules/.prisma/

# OS
.DS_Store
Thumbs.db
