# ============================================================
#  ACLC — CodeNeticz KHacks 3.0
#  .gitignore  (root — covers ALL sub-projects)
# ============================================================

# ── 🔐 SECRETS & ENV (NEVER commit these) ──────────────────
.env
.env.*
!.env.example        # keep the template
*.env

# ── 📦 NODE / NPM ──────────────────────────────────────────
node_modules/
backend/server/node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# ── ⚡ VITE / BUILD OUTPUT ──────────────────────────────────
dist/
dist-ssr/
build/
frontend/dist/
frontend/build/
*.local

# ── 🐍 PYTHON ──────────────────────────────────────────────
venv/
.venv/
env/
*.egg-info/
*.pyc
*.pyo
*.pyd
__pycache__/
.Python
pip-wheel-metadata/
.pytest_cache/

# Specific venv paths used in sub-projects
cognitive_disability/dyslexia/venv/
cognitive_disability/dyscalculia/venv/
backend/ML/Dyslexia/venv/

# ── 🤖 ML / AI MODEL FILES (too large for Git) ─────────────
cache/
*.bin
*.safetensors
*.h5
*.pt
*.ckpt
*.onnx
word_cache.json

# ── 🗄️ DATABASE ────────────────────────────────────────────
*.sqlite
*.sqlite3
*.db

# ── 📁 UPLOADS & LOGS (runtime user data) ──────────────────
uploads/
backend/server/uploads/
backend/public/
logs/
*.log
backend/server/logs/

# ── 🖥️ EDITOR, IDE & AGENT ARTIFACTS ───────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.gemini/
.brain/

# ── 🖼️ OS JUNK ─────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# ── 🔧 MISC ────────────────────────────────────────────────
*.dll
*.so
*.dylib
*.exe
*.lib
*.a
*.obj
*.o
coverage/
*.lcov
.nyc_output/
*.tsbuildinfo